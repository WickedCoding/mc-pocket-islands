{
  "schemaVersion": 1,
  "id": "personalworlds",
  "version": "${version}",
  "name": "Pocket Islands",
  "description": "Give each player their own pocket dimension island that survives world resets",
  "authors": ["Jurriën"],
  "license": "MIT",
  "icon": "assets/personalworlds/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.wickedsik.personalworlds.platform.fabric.FabricEntrypoint"]
  },
  "mixins": ["pocketislands.mixins.json", "pocketislands.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*"
  }
}
